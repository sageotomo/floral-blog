---
// 日記列表：本身是堆疊裡的一頁（窄欄）。點一篇就在右邊打開。
import { getCollection } from 'astro:content';
import StackShell from '../../components/StackShell.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const dateLabel = (date: Date) => new Intl.DateTimeFormat('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' }).format(date);
---
<StackShell paneKey="blog" title="日記" description="有日期的紀錄，照時間排。" narrow>
  <header class="article-header">
    <h1>日記</h1>
    <p class="article-meta"><span>{posts.length} 篇</span></p>
  </header>
  <nav class="entry-list" aria-label="日記列表">
    <ul>{posts.map((post) => <li><a href={`/blog/${post.id}/`}><span>{post.data.title}</span><time datetime={post.data.pubDate.toISOString()}>{dateLabel(post.data.pubDate)}</time></a></li>)}</ul>
  </nav>
</StackShell>
